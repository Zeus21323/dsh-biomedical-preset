{
  "name": "dsh-biomedical-preset",
  "version": "2.6.0",
  "type": "module",
  "description": "生物医学模式 — DSH agent preset for biomedical research (omics, clinical, structure, literature, writing)",
  "engines": {
    "dsh": "^0.2.1-rc.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./settings": "./settings/index.js",
    "./subagent-cap": "./subagent-cap.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./picker": "./picker/index.js",
    "./paths": "./paths.cjs"
  },
  "files": [
    "cordis.patch.yml",
    "index.js",
    "client.js",
    "subagent-cap.mjs",
    "paths.cjs",
    "shared/**",
    "icon.svg",
    "locale/*.json",
    "mcp/**",
    "skills/**",
    "picker/**",
    "settings/**",
    "THIRD_PARTY.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-shell"
      ]
    }
  },
  "license": "MIT"
}
