  "plugins": [
    {
      "name": "dsh-biomedical-preset",
      "title": {
        "en": "Biomedical Mode",
        "zh": "生物医学模式"
      },
      "description": {
        "en": "Biomedical research collaborator preset: bulk/single-cell omics, variant and clinical annotation, structure prediction and docking, literature evidence grading, survival statistics, publication figures and manuscripts. Ships its own MCP server (51 tools over PubMed/Ensembl/PDB/AlphaFold/ClinVar/gnomAD/GTEx/GEO/PRIDE/cBioPortal/CIViC/ENCODE/JASPAR/Rfam/ChEMBL/PubChem/Open Targets/openFDA/OpenAlex/arXiv) and 63 skills, so it carries no dependency on external plugin directories.",
        "zh": "生物医学研究合作者预设：组学分析（蛋白组/代谢组/单细胞/微生物组/空间病理）、临床与变异注释、结构预测与分子对接、文献证据分级、生存统计、投稿级图表与稿件。自带 MCP 服务（51 个公开数据源工具）与 78 个流程技能，不依赖任何外部插件目录。"
      },
