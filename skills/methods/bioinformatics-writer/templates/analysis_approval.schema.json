{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bioinformatics Writer analysis approval receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approval_choice",
    "approval_source",
    "approved_in_current_conversation",
    "user_approval_text",
    "approved_prd_sha256",
    "approved_inventory_sha256"
  ],
  "properties": {
    "approval_choice": {
      "const": "approved"
    },
    "approval_source": {
      "enum": ["ask_user", "direct_chat"]
    },
    "approved_in_current_conversation": {
      "const": true
    },
    "user_approval_text": {
      "type": "string",
      "minLength": 1
    },
    "approved_prd_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "approved_inventory_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
