{
  "version": "2.0.0",
  "说明": "术语与数据输出保真锁定使用的不变量识别目录。categories 按顺序匹配，先命中的类别占据文本区间，后续类别不再覆盖同一区间。kind 决定校验方式：identifier/name 作为绑定实体，number/date 作为绑定值，reference 只记录不参与数据比较。novel_check 为 true 的类别在输出中出现却不在来源中时按凭空新增报告。通用类别（日期、金额、区间、版本、时刻、通用编码）与生物医学类别并列，使同一套脚本可用于任何含数据的文本。",
  "categories": [
    {
      "id": "ensembl",
      "name_cn": "Ensembl 基因/转录本/蛋白/外显子/调控元件编号",
      "kind": "identifier",
      "pattern": "\\bENS[A-Z]{0,5}(?:G|T|P|E|R|FM|GT)\\d{11}(?:\\.\\d+)?\\b",
      "novel_check": true,
      "versioned": true
    },
    {
      "id": "refseq",
      "name_cn": "RefSeq 转录本/蛋白/基因组编号",
      "kind": "identifier",
      "pattern": "\\b(?:NM|NR|NP|XM|XR|XP|NC|NG|NT|NW|NZ|WP|YP|AP|AC)_\\d{4,}(?:\\.\\d+)?\\b",
      "novel_check": true,
      "versioned": true
    },
    {
      "id": "uniprot",
      "name_cn": "UniProt 蛋白登录号",
      "kind": "identifier",
      "pattern": "\\b(?:[OPQ][0-9][A-Z0-9]{3}[0-9]|[A-NR-Z][0-9](?:[A-Z][A-Z0-9]{2}[0-9]){1,2})(?:-\\d+)?\\b",
      "novel_check": true,
      "versioned": false
    },
    {
      "id": "dbsnp",
      "name_cn": "dbSNP 变异编号",
      "kind": "identifier",
      "pattern": "\\brs\\d{3,}\\b",
      "novel_check": true,
      "versioned": false
    },
    {
      "id": "hgvs",
      "name_cn": "HGVS 变异记法（c./g./p./m./n./r./o.）",
      "kind": "identifier",
      "pattern": "(?<![A-Za-z0-9])(?:[cgmnor]\\.\\(?[0-9*+\\-][A-Za-z0-9_*+>=?\\-\\[\\]]*|p\\.\\(?(?:[A-Z][a-z]{2}|[A-Z*=?])\\d+[A-Za-z0-9_*+>=?\\-\\[\\]]*)",
      "novel_check": true,
      "versioned": false
    },
    {
      "id": "genome-coordinate",
      "name_cn": "染色体坐标区间",
      "kind": "identifier",
      "pattern": "\\b(?:chr)?(?:[1-9]|1\\d|2[0-2]|X|Y|MT|M)[:_]\\d[\\d,]{2,}(?:\\s?[-–]\\s?\\d[\\d,]*)?\\b",
      "novel_check": true,
      "versioned": false
    },
    {
      "id": "cytoband",
      "name_cn": "细胞遗传学条带",
      "kind": "identifier",
      "pattern": "\\b(?:[1-9]|1\\d|2[0-2]|X|Y)[pq]\\d{1,2}(?:\\.\\d{1,3})?\\b",
      "novel_check": false,
      "versioned": false
    },
    {
      "id": "genome-build",
      "name_cn": "参考基因组版本",
      "kind": "identifier",
      "pattern": "\\b(?:GRCh3[78](?:\\.p\\d+)?|GRCm3[89]|hg19|hg38|mm10|mm39|GRCz1[01]|rn[67]|T2T-CHM13(?:v\\d+(?:\\.\\d+)?)?|TAIR10)\\b",
      "novel_check": true,
      "versioned": false
    },
    {
      "id": "ontology",
      "name_cn": "本体与疾病编号（GO/HP/MONDO/DOID/OMIM/HGNC/EFO）",
      "kind": "identifier",
      "pattern": "\\b(?:GO|HP|MONDO|DOID|HGNC|EFO|CL|UBERON|ECO|SO|CHEBI|MGI|ZFIN|RGD|OMIM|ORPHA)[:_]\\s?\\d{3,}\\b",
      "novel_check": true,
      "versioned": false
    },
    {
      "id": "pathway-domain",
      "name_cn": "通路与结构域编号（KEGG/Reactome/Pfam/InterPro/SMART）",
      "kind": "identifier",
      "pattern": "\\b(?:hsa|mmu|rno|dre|ath|map|ko|M)\\d{5}\\b|\\bR-(?:HSA|MMU|RNO|DRE)-\\d+\\b|\\bPF\\d{5}(?:\\.\\d+)?\\b|\\bIPR\\d{6}\\b|\\bSM\\d{5}\\b|\\bK\\d{5}\\b",
      "novel_check": true,
      "versioned": false
    },
    {
      "id": "compound-drug",
      "name_cn": "化合物与药物编号（PubChem/ChEMBL/DrugBank/CAS）",
      "kind": "identifier",
      "pattern": "\\bCID[: ]?\\d{2,}\\b|\\bCHEMBL\\d+\\b|\\bDB\\d{5}\\b|\\bCAS[: ]?\\d{2,7}-\\d{2}-\\d\\b|\\bZINC\\d{6,}\\b",
      "novel_check": true,
      "versioned": false
    },
    {
      "id": "structure",
      "name_cn": "PDB 与 AlphaFold 结构编号",
      "kind": "identifier",
      "pattern": "\\bPDB[: ]?[1-9][A-Za-z0-9]{3}\\b|\\bAF-[A-Z0-9]{6,10}-F\\d+\\b|\\bEMD-\\d{4,5}\\b",
      "novel_check": true,
      "versioned": false
    },
    {
      "id": "data-archive",
      "name_cn": "公共数据登录号（GEO/SRA/ENA/BioProject/BioSample/PRIDE/MetaboLights/TCGA）",
      "kind": "identifier",
      "pattern": "\\bGS[EM]\\d{3,}\\b|\\bGPL\\d{2,}\\b|\\b[SED]R[APRSXZ]\\d{5,}\\b|\\bPRJ[NED][AB]\\d+\\b|\\bSAM[NED]A?\\d+\\b|\\bPXD\\d{6}\\b|\\bMTBLS\\d+\\b|\\bE-[A-Z]{4}-\\d+\\b|\\bphs\\d{6}(?:\\.v\\d+(?:\\.p\\d+)?)?\\b|\\bEGA[SD]\\d{11}\\b|\\bTCGA-[A-Z0-9]{2}-[A-Z0-9]{4}(?:-[A-Z0-9]{3}){0,4}\\b",
      "novel_check": true,
      "versioned": false
    },
    {
      "id": "literature-trial",
      "name_cn": "文献与试验编号（PMID/DOI/PMC/NCT/ChiCTR）",
      "kind": "identifier",
      "pattern": "\\bPMID:?\\s?\\d{6,9}\\b|\\bPMC\\d{5,9}\\b|\\b(?:doi:|DOI:|https?://doi\\.org/)?10\\.\\d{4,9}/[^\\s\\\"<>,;)]+|\\bNCT\\d{8}\\b|\\bChiCTR\\d{10}\\b|\\bISRCTN\\d{8}\\b",
      "novel_check": true,
      "versioned": false
    },
    {
      "id": "cell-line",
      "name_cn": "常见细胞系与模式生物名称",
      "kind": "name",
      "pattern": "\\b(?:HEK ?293[A-Z]?|HeLa|HepG2|Huh-?7|A549|MCF-?7|MCF-?10A|K562|Jurkat|THP-?1|U2OS|U-?87 ?MG|HCT-?116|SH-SY5Y|PC-?3|PC-?9|NIH/?3T3|CHO(?:-K1)?|RAW ?264\\.7|Caco-?2|MDA-MB-\\d{3}|HT-?29|SW-?480|SW-?620|LNCaP|HUVEC|iPSC|hESC|H1299|H460|BEAS-2B|C2C12|HL-?60|Vero(?: E6)?|MRC-?5|IMR-?90|Hep3B|SKOV-?3|OVCAR-?\\d|Panc-?1|BxPC-?3|MIA PaCa-2|DU-?145|22Rv1|T-?47D|BT-?474|SK-BR-3|U-?251|LN-?229|Neuro-?2a|N2a|GL261|B16(?:-F10)?|4T1|CT26|MC38|LLC|E\\.\\s?coli|S\\.\\s?cerevisiae|C\\.\\s?elegans|D\\.\\s?melanogaster|M\\.\\s?musculus|A\\.\\s?thaliana)\\b",
      "novel_check": false,
      "versioned": false
    },
    {
      "id": "sequence",
      "name_cn": "核酸或蛋白序列片段",
      "kind": "sequence",
      "pattern": "\\b[ACGTUN]{12,}\\b|\\b(?=[A-Z]{20,}\\b)(?=.*[DEFHIKLMPQRSVWY])[ACDEFGHIKLMNPQRSTVWY]{20,}\\b",
      "novel_check": true,
      "versioned": false
    },
    {
      "id": "file-path",
      "name_cn": "文件名与路径",
      "kind": "path",
      "pattern": "(?<![\\w/])[\\w.\\-]+(?:/[\\w.\\-]+)*\\.(?:csv|tsv|txt|xlsx?|docx?|pptx?|json|ya?ml|fastq(?:\\.gz)?|fq(?:\\.gz)?|fasta?(?:\\.gz)?|fna|faa|bam|cram|sam|vcf(?:\\.gz)?|bcf|bed|gtf|gff3?|h5ad|h5|rds|RData|loom|mtx|pdf|png|svg|html|log|nf|py|R|sh)\\b",
      "novel_check": false,
      "versioned": false
    },
    {
      "id": "date",
      "name_cn": "日期",
      "kind": "date",
      "pattern": "\\b\\d{4}\\s?[-/.年]\\s?\\d{1,2}\\s?[-/.月]\\s?\\d{1,2}\\s?日?(?![\\d:])|\\b\\d{1,2}\\s(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Sept|Oct|Nov|Dec)[a-z]*\\.?,?\\s\\d{4}\\b|\\b(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Sept|Oct|Nov|Dec)[a-z]*\\.?\\s\\d{1,2},?\\s\\d{4}\\b",
      "novel_check": true,
      "versioned": false
    },
    {
      "id": "cross-reference",
      "name_cn": "图表、章节、方法与步骤编号（非数据）",
      "kind": "reference",
      "pattern": "(?:\\bTables?|\\bTab\\.|\\bFig(?:ure)?s?\\.?|\\bSections?|\\bSect\\.|\\bMethods?|\\bSupplementary|\\bSuppl\\.|\\bChapter|\\bSteps?|\\bEq\\.?|\\bEquations?|\\bNotes?|\\bAppendix|\\bPanels?|\\bLanes?|\\bRefs?\\.?|\\bPage|\\bp\\.|表|图|附表|附图|附录|方法|章节|章|节|第|步骤|公式|注|面板|参考文献|页)\\s?[SE]?\\d+(?:[.\\-]\\d+)*[A-Za-z]?(?![0-9])",
      "novel_check": false,
      "versioned": false
    },
    {
      "id": "software-version",
      "name_cn": "软件或数据版本号",
      "kind": "identifier",
      "pattern": "\\b(?:v|ver\\.?\\s?|version\\s?)?\\d+\\.\\d+\\.\\d+(?:[-+.][0-9A-Za-z]+)*\\b",
      "novel_check": true,
      "versioned": false
    },
    {
      "id": "currency",
      "name_cn": "金额",
      "kind": "number",
      "pattern": "(?<![A-Za-z0-9.\\-])[$¥€£]\\s?(?:\\d{1,3}(?:,\\d{3})+|\\d+)(?:\\.\\d+)?(?:\\s?(?:万|亿|k|K|M|B))?|(?<![A-Za-z0-9.\\-])(?:\\d{1,3}(?:,\\d{3})+|\\d+)(?:\\.\\d+)?\\s?(?:万元|亿元|元|美元|欧元|英镑|USD|CNY|EUR|GBP|RMB)(?![A-Za-z])",
      "novel_check": true,
      "versioned": false
    },
    {
      "id": "number-range",
      "name_cn": "数值区间",
      "kind": "number",
      "pattern": "(?:(?<![0-9.\\-])[<>≤≥]\\s?=?\\s?|(?<![A-Za-z0-9.\\-]))[-−+]?(?:\\d{1,3}(?:,\\d{3})+|\\d+)(?:\\.\\d+)?(?:\\s?(?:[×x]\\s?10\\s?\\^?\\s?[-−⁻+⁺]?[⁰¹²³⁴⁵⁶⁷⁸⁹\\d]+|[eE][-−+]?\\d+))?\\s?(?:[-–~]|至|到)\\s?[-−+]?(?:\\d{1,3}(?:,\\d{3})+|\\d+)(?:\\.\\d+)?(?:\\s?(?:[×x]\\s?10\\s?\\^?\\s?[-−⁻+⁺]?[⁰¹²³⁴⁵⁶⁷⁸⁹\\d]+|[eE][-−+]?\\d+))?(?:\\s?%|\\s?(?:ng/µL|ng/μL|ng/uL|ng/mL|µg/mL|μg/mL|ug/mL|mg/mL|mg/kg|mg/dL|mmol/L|µmol/L|umol/L|nmol/L|IU/mL|U/mL|U/L|cells/mL|cells/well|copies/mL|reads/sample|kbp|Mbp|Gbp|kDa|FPKM|RPKM|TPM|CPM|mmHg|rpm|×g|x\\ g|km/h|m/s|kWh|GB|MB|TB|KB|Hz|kHz|MHz|GHz|ng|µg|ug|μg|mg|kg|pg|fg|µL|uL|μL|mL|nL|pL|nM|µM|uM|μM|mM|pM|fM|bp|kb|Mb|Gb|nt|aa|Da|°C|℃|°F|cm|mm|µm|um|μm|nm|km|m|g|L|V|mV|mA|W|kW|Pa|kPa|MPa|reads|hours|hour|hrs|hr|h|days|day|d|weeks|week|wk|months|month|years|year|yrs|yr|min|s|sec|ms))?(?![A-Za-z0-9])",
      "novel_check": true,
      "versioned": false
    },
    {
      "id": "number-with-unit",
      "name_cn": "带单位数值",
      "kind": "number",
      "pattern": "(?:(?<![0-9.\\-])[<>≤≥]\\s?=?\\s?|(?<![A-Za-z0-9.\\-]))[-−+]?(?:\\d{1,3}(?:,\\d{3})+|\\d+)(?:\\.\\d+)?(?:\\s?(?:[×x]\\s?10\\s?\\^?\\s?[-−⁻+⁺]?[⁰¹²³⁴⁵⁶⁷⁸⁹\\d]+|[eE][-−+]?\\d+))?\\s?(?:ng/µL|ng/μL|ng/uL|ng/mL|µg/mL|μg/mL|ug/mL|mg/mL|mg/kg|mg/dL|mmol/L|µmol/L|umol/L|nmol/L|IU/mL|U/mL|U/L|cells/mL|cells/well|copies/mL|reads/sample|kbp|Mbp|Gbp|kDa|FPKM|RPKM|TPM|CPM|mmHg|rpm|×g|x\\ g|km/h|m/s|kWh|GB|MB|TB|KB|Hz|kHz|MHz|GHz|ng|µg|ug|μg|mg|kg|pg|fg|µL|uL|μL|mL|nL|pL|nM|µM|uM|μM|mM|pM|fM|bp|kb|Mb|Gb|nt|aa|Da|°C|℃|°F|cm|mm|µm|um|μm|nm|km|m|g|L|V|mV|mA|W|kW|Pa|kPa|MPa|reads|hours|hour|hrs|hr|h|days|day|d|weeks|week|wk|months|month|years|year|yrs|yr|min|s|sec|ms)(?![A-Za-z])",
      "novel_check": true,
      "versioned": false
    },
    {
      "id": "time",
      "name_cn": "时刻",
      "kind": "number",
      "pattern": "\\b\\d{1,2}:[0-5]\\d(?::[0-5]\\d)?\\b(?![\\d,])",
      "novel_check": false,
      "versioned": false
    },
    {
      "id": "number",
      "name_cn": "数据型数值（小数、科学计数、阈值符号、百分比、带符号或两位以上整数）",
      "kind": "number",
      "pattern": "(?:(?<![0-9.\\-])[<>≤≥]\\s?=?\\s?|(?<![A-Za-z0-9.\\-]))[-−+]?(?:\\d{1,3}(?:,\\d{3})+|\\d+)(?:\\.\\d+)?(?:\\s?(?:[×x]\\s?10\\s?\\^?\\s?[-−⁻+⁺]?[⁰¹²³⁴⁵⁶⁷⁸⁹\\d]+|[eE][-−+]?\\d+))?(?:\\s?%)?(?![A-Za-z_])(?!\\.?\\d)",
      "novel_check": true,
      "versioned": false,
      "data_like_only": true
    },
    {
      "id": "fusion-gene",
      "name_cn": "融合基因写法",
      "kind": "identifier",
      "pattern": "\\b[A-Z][A-Z0-9]{1,9}(?:::|-|–|/)[A-Z][A-Z0-9]{1,9}\\b(?![-:/])",
      "novel_check": false,
      "versioned": false,
      "post_filter": "fusion"
    },
    {
      "id": "gene-symbol",
      "name_cn": "人类/大写风格基因或蛋白符号（含希腊字母与家族后缀）",
      "kind": "identifier",
      "pattern": "\\b[A-Z][A-Z0-9]{1,9}(?:-?(?:[αβγδεκλ]|alpha|beta|gamma|delta|epsilon|kappa|lambda|[abgd](?![A-Za-z0-9]))|(?:-[A-Z0-9]{1,6}){1,2})?\\b",
      "novel_check": false,
      "versioned": false,
      "post_filter": "gene-symbol"
    },
    {
      "id": "gene-symbol-mixed",
      "name_cn": "小鼠/大鼠风格基因符号（首字母大写、含数字）",
      "kind": "identifier",
      "pattern": "\\b[A-Z][a-z]{1,8}\\d[A-Za-z0-9]*\\b",
      "novel_check": false,
      "versioned": false
    },
    {
      "id": "gene-symbol-mixed-nodigit",
      "name_cn": "小鼠/大鼠风格无数字基因符号（首字母大写，非句首）",
      "kind": "identifier",
      "pattern": "(?<=[a-z0-9,，;；:：(（\\s])(?<![.!?。！？]\\s)[A-Z][a-z]{2,7}\\b(?![a-z])",
      "novel_check": false,
      "versioned": false,
      "post_filter": "capitalized"
    },
    {
      "id": "catalog-code",
      "name_cn": "通用字母数字编码（货号、批号、订单号、设备编号）",
      "kind": "identifier",
      "pattern": "\\b[A-Z]{1,5}[-_]?\\d{4,}(?:[-_]?[A-Z0-9]+)*\\b",
      "novel_check": true,
      "versioned": false
    },
    {
      "id": "sample-name",
      "name_cn": "样本、分组与实验条件名称",
      "kind": "name",
      "pattern": "\\b[A-Za-z][A-Za-z0-9]*(?:[_\\-][A-Za-z0-9]+)+\\b",
      "novel_check": false,
      "versioned": false,
      "require_digit": true
    }
  ],
